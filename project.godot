; Archivo de configuración del proyecto de Godot.

config_version=5

[application]

config/name="Tameworld"
config/description="RPG de mundo abierto en pixel art 3D: captura criaturas y pelea controlándolas."
run/main_scene="res://scenes/world.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

InputSetup="*res://scripts/core/input_setup.gd"
GameState="*res://scripts/core/game_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
